# Edit the matching lines in the .env that Laravel created for you.
APP_NAME=Rolliepods
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rolliepods_db
DB_USERNAME=root
DB_PASSWORD=

# The database only has the 3 tables from rolliepods.sql, so keep these off the database:
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
